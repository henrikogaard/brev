{
  "sourceLanguage": "en",
  "strings": {
    "AI Writer is not enabled. Enable it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-skriver er ikke aktivert. Aktiver den i Innstillinger."
          }
        }
      }
    },
    "AI Writer sends your text to the configured account AI endpoint.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-skriver sender teksten din til kontoens konfigurerte AI-endepunkt."
          }
        }
      }
    },
    "AI Writer v1 requires an account backend with server-side AI support.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-skriver v1 krever en kontobackend med AI-støtte på serversiden."
          }
        }
      }
    },
    "Apple Intelligence is currently unavailable on this device.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er for øyeblikket ikke tilgjengelig på denne enheten."
          }
        }
      }
    },
    "Apple Intelligence is still preparing its on-device model. Try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence forbereder fortsatt modellen på enheten. Prøv igjen om litt."
          }
        }
      }
    },
    "BYOK/local providers are planned for v2, so this account stays disabled until a provider is configured.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "BYOK og lokale leverandører er planlagt for v2, så denne kontoen forblir deaktivert til en leverandør er konfigurert."
          }
        }
      }
    },
    "Blocked a non-HTTPS or disallowed redirect while downloading the model.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkerte en ikke-HTTPS- eller ikke-tillatt omdirigering under nedlasting av modellen."
          }
        }
      }
    },
    "Brev computes counts locally and requires your exact confirmation before any mutation runs.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev beregner antall lokalt og krever eksakt bekreftelse fra deg før en endring kjøres."
          }
        }
      }
    },
    "Could not download the local model: %@": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste ned den lokale modellen: %@"
          }
        }
      }
    },
    "Could not save the local model on this device: %@": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre den lokale modellen på denne enheten: %@"
          }
        }
      }
    },
    "Couldn't access the provider API key in Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få tilgang til leverandørens API-nøkkel i Nøkkelringen."
          }
        }
      }
    },
    "Download a local model in Settings before running on-device AI.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned en lokal modell i Innstillinger før du kjører AI på enheten."
          }
        }
      }
    },
    "Enter a model ID.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en modell-ID."
          }
        }
      }
    },
    "Enter a provider display name.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et visningsnavn for leverandøren."
          }
        }
      }
    },
    "Enter an http or https endpoint URL.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en http- eller https-endepunkts-URL."
          }
        }
      }
    },
    "It does not receive message bodies, attachments, matched message IDs, or mailbox indexes.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det mottar ikke meldingstekster, vedlegg, matchede meldings-ID-er eller postkasseindekser."
          }
        }
      }
    },
    "It stays hidden until mailbox-action AI is explicitly enabled for a supported account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det forblir skjult til AI for postkassehandlinger er uttrykkelig aktivert for en støttet konto."
          }
        }
      }
    },
    "Mailbox Assistant requires an account backend with an available AI provider.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Postkasseassistent krever en kontobackend med en tilgjengelig AI-leverandør."
          }
        }
      }
    },
    "Mailbox Assistant sends your typed request to the configured account AI endpoint to plan mailbox actions.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Postkasseassistent sender forespørselen du skriver til kontoens konfigurerte AI-endepunkt for å planlegge postkassehandlinger."
          }
        }
      }
    },
    "Model download failed with HTTP status %lld.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellnedlasting feilet med HTTP-status %lld."
          }
        }
      }
    },
    "Model downloads require an HTTPS URL.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellnedlastinger krever en HTTPS-URL."
          }
        }
      }
    },
    "Needs reply": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenger svar"
          }
        }
      }
    },
    "Network error: %@": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksfeil: %@"
          }
        }
      }
    },
    "On this Mac": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne Mac-en"
          }
        }
      }
    },
    "On this Mac (Apple Intelligence)": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne Mac-en (Apple Intelligence)"
          }
        }
      }
    },
    "On this Mac (download a model)": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne Mac-en (last ned en modell)"
          }
        }
      }
    },
    "On this iPad": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne iPad-en"
          }
        }
      }
    },
    "On this iPad (Apple Intelligence)": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne iPad-en (Apple Intelligence)"
          }
        }
      }
    },
    "On this iPad (download a model)": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne iPad-en (last ned en modell)"
          }
        }
      }
    },
    "On this iPhone": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne iPhone-en"
          }
        }
      }
    },
    "On this iPhone (Apple Intelligence)": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne iPhone-en (Apple Intelligence)"
          }
        }
      }
    },
    "On this iPhone (download a model)": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne iPhone-en (last ned en modell)"
          }
        }
      }
    },
    "Only the content generated from your request is shared with the provider endpoint.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare innholdet generert fra forespørselen din deles med leverandørens endepunkt."
          }
        }
      }
    },
    "Provider-hosted AI assistant": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandørhostet AI-assistent"
          }
        }
      }
    },
    "Provider-hosted mailbox assistant": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandørhostet postkasseassistent"
          }
        }
      }
    },
    "Ready on this device. Text stays local and works offline.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar på denne enheten. Teksten forblir lokal og fungerer uten nett."
          }
        }
      }
    },
    "Requires iOS 26 or later.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krever iOS 26 eller nyere."
          }
        }
      }
    },
    "Requires macOS 26 or later.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krever macOS 26 eller nyere."
          }
        }
      }
    },
    "Sent to: Provider-hosted AI": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendt til: Leverandørhostet AI"
          }
        }
      }
    },
    "Server error (%@): %@": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfeil (%@): %@"
          }
        }
      }
    },
    "The content was filtered by the AI provider.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innholdet ble filtrert av AI-leverandøren."
          }
        }
      }
    },
    "The downloaded model file failed SHA-256 verification and was removed.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nedlastede modellfilen bestod ikke SHA-256-verifisering og ble fjernet."
          }
        }
      }
    },
    "The downloaded model weights are verified on this device, but no compatible local inference runtime is installed yet.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De nedlastede modellvektene er verifisert på denne enheten, men ingen kompatibel lokal kjøretid for inferens er installert ennå."
          }
        }
      }
    },
    "The local model runtime failed to generate a response: %@": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale modellkjøretiden kunne ikke generere et svar: %@"
          }
        }
      }
    },
    "The model download exceeded the expected file size and was cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellnedlastingen oversteg forventet filstørrelse og ble avbrutt."
          }
        }
      }
    },
    "The model download was cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellnedlastingen ble avbrutt."
          }
        }
      }
    },
    "The provider API key stored in Keychain is unreadable.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandørens API-nøkkel lagret i Nøkkelringen er uleselig."
          }
        }
      }
    },
    "The requested local model is not in Brev’s catalog.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forespurte lokale modellen finnes ikke i Brevs katalog."
          }
        }
      }
    },
    "This device does not support Apple Intelligence.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten støtter ikke Apple Intelligence."
          }
        }
      }
    },
    "This message is too long for the on-device model. Try a shorter selection or thread.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne meldingen er for lang for modellen på enheten. Prøv et kortere utvalg eller en kortere tråd."
          }
        }
      }
    },
    "Too many requests. Please wait a moment and try again.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forespørsler. Vent litt og prøv igjen."
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to use on-device AI.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence i Systeminnstillinger for å bruke AI på enheten."
          }
        }
      }
    },
    "Urgent": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Haster"
          }
        }
      }
    },
    "Your AI request is processed by the account provider and is not used for model training by default.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-forespørselen din behandles av kontoens leverandør og brukes som standard ikke til modelltrening."
          }
        }
      }
    }
  },
  "version": "1.0"
}
