        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneradresser må bruke https://."
          }
        }
      }
    },
    "Do not include credentials in the JMAP server URL. Use the API token field instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include credentials in the JMAP server URL. Use the API token field instead."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke inkluder påloggingsinfo i JMAP-adressen. Bruk API-token-feltet i stedet."
          }
        }
      }
    },
    "The JMAP server URL must include a host name.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
