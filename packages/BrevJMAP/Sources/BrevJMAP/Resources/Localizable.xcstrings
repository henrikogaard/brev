  "strings": {
    "Enter a JMAP server URL or domain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a JMAP server URL or domain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en JMAP-tjeneradresse eller et domene."
          }
        }
      }
    },
    "The JMAP server URL is not valid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The JMAP server URL is not valid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneradressen er ikke gyldig."
          }
        }
      }
    },
    "JMAP server URLs must use https://.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP server URLs must use https://."
