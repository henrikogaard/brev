{
  "sourceLanguage": "en",
  "strings": {
    "Enter a JMAP server URL or domain.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en JMAP-tjeneradresse eller et domene."
          }
        }
      }
    },
    "The JMAP server URL is not valid.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneradressen er ikke gyldig."
          }
        }
      }
    },
    "JMAP server URLs must use https://.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneradresser må bruke https://."
          }
        }
      }
    },
    "Do not include credentials in the JMAP server URL. Use the API token field instead.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke inkluder påloggingsinfo i JMAP-adressen. Bruk API-token-feltet i stedet."
          }
        }
      }
    },
    "The JMAP server URL must include a host name.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneradressen må inneholde et vertsnavn."
          }
        }
      }
    },
    "The JMAP server redirected to an insecure address.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren viderekoblet til en usikker adresse."
          }
        }
      }
    },
    "The JMAP server redirected to a different host.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren viderekoblet til en annen vert."
          }
        }
      }
    },
    "The JMAP server redirected too many times.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren viderekoblet for mange ganger."
          }
        }
      }
    },
    "JMAP sign-in failed or the API token was rejected.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-pålogging mislyktes, eller API-tokenet ble avvist."
          }
        }
      }
    },
    "The JMAP server denied access to this mailbox.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren nektet tilgang til denne postboksen."
          }
        }
      }
    },
    "The JMAP server rate-limited requests. Try again in %lld seconds.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren begrenset antall forespørsler. Prøv igjen om %lld sekunder."
          }
        }
      }
    },
    "The JMAP server rate-limited requests. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren begrenset antall forespørsler. Prøv igjen senere."
          }
        }
      }
    },
    "The JMAP server is temporarily unavailable (HTTP %lld).": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren er midlertidig utilgjengelig (HTTP %lld)."
          }
        }
      }
    },
    "The JMAP server rejected the request (HTTP %lld).": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren avviste forespørselen (HTTP %lld)."
          }
        }
      }
    },
    "Brev could not reach the JMAP server.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev fikk ikke kontakt med JMAP-tjeneren."
          }
        }
      }
    },
    "The JMAP server returned a response Brev could not read.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren returnerte et svar Brev ikke kunne lese."
          }
        }
      }
    },
    "The JMAP server did not advertise a primary mail account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren oppga ingen primær e-postkonto."
          }
        }
      }
    },
    "The JMAP server reported an error (%@).": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren rapporterte en feil (%@)."
          }
        }
      }
    },
    "The JMAP mailbox needs a full refresh.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-postboksen trenger en full oppdatering."
          }
        }
      }
    },
    "The requested JMAP item could not be found.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke det forespurte JMAP-elementet."
          }
        }
      }
    },
    "The attachment exceeds the JMAP server upload limit (%lld bytes).": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedlegget overskrider opplastingsgrensen til JMAP-tjeneren (%lld byte)."
          }
        }
      }
    },
    "No sending identity is available on this JMAP account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen avsenderidentitet er tilgjengelig på denne JMAP-kontoen."
          }
        }
      }
    },
    "Could not find a Drafts folder on this JMAP account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen Utkast-mappe på denne JMAP-kontoen."
          }
        }
      }
    },
    "Could not find a Sent folder on this JMAP account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen Sendt-mappe på denne JMAP-kontoen."
          }
        }
      }
    },
    "The JMAP server advertised an invalid download address.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren oppga en ugyldig nedlastingsadresse."
          }
        }
      }
    },
    "The JMAP server advertised an invalid upload address.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP-tjeneren oppga en ugyldig opplastingsadresse."
          }
        }
      }
    },
    "Saved JMAP account settings are incomplete or invalid.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrede JMAP-kontoinnstillinger er ufullstendige eller ugyldige."
          }
        }
      }
    },
    "JMAP API token is unavailable in Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP API-token er ikke tilgjengelig i Nøkkelring."
          }
        }
      }
    }
  },
  "version": "1.0"
}
