{
  "sourceLanguage": "en",
  "strings": {
    "%@ doesn't look like a valid email address": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ser ikke ut som en gyldig e-postadresse"
          }
        }
      }
    },
    "%@ uses Google OAuth2. Prefer Sign in with Google when this build has a Google OAuth client ID, or use a Google app password from a 2-Step Verification-enabled account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bruker Google OAuth2. Foretrekk Logg inn med Google når dette bygget har en Google OAuth-klient-ID, eller bruk et Google app-passord fra en konto med totrinns­verifisering."
          }
        }
      }
    },
    "%@ uses Microsoft OAuth2. Prefer Sign in with Microsoft when this build has a Microsoft OAuth client ID. Manual password IMAP/SMTP setup is usually blocked for Outlook and Microsoft 365 mailboxes.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bruker Microsoft OAuth2. Foretrekk Logg inn med Microsoft når dette bygget har en Microsoft OAuth-klient-ID. Manuelt IMAP/SMTP-oppsett med passord er vanligvis blokkert for Outlook- og Microsoft 365-postkasser."
          }
        }
      }
    },
    "%@ uses OAuth2. Prefer Sign in with Google or Microsoft when configured for this build, or use an IMAP/SMTP app password if your provider supports one.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bruker OAuth2. Foretrekk Logg inn med Google eller Microsoft når det er konfigurert for dette bygget, eller bruk et IMAP/SMTP-app-passord hvis leverandøren din støtter det."
          }
        }
      }
    },
    "%@ uses encrypted-password challenge authentication, which Brev does not support yet. Change it to Password or App Password over TLS/STARTTLS before adding the account.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bruker kryptert-passord-autentisering, som Brev ikke støtter ennå. Bytt til Passord eller App-passord over TLS/STARTTLS før du legger til kontoen."
          }
        }
      }
    },
