# Local desktop run configuration.
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local overrides.
# `.env.local` is listed in .gitignore and must never be committed.
#
# Validate the local run configuration with:
#   ./script/build_and_run.sh --preflight
#
# -----------------------------------------------------------------------------
# MOCK MODE (optional explicit override)
# -----------------------------------------------------------------------------

# Normal developer launches leave this unset and use the in-app Developer
# setting to decide whether Brev starts with the demo mailbox.
# Set to 1 to force MockBackend with fixture data.
# Set to 0 to force live IMAP/SMTP account setup.
# BREV_USE_MOCK=1

# -----------------------------------------------------------------------------
# LIVE MODE
# -----------------------------------------------------------------------------
# Brev uses standards-first IMAP/SMTP plus the Gmail API for live mail accounts.
# Server settings and credentials are entered in the app's account setup flow.

# -----------------------------------------------------------------------------
# OAUTH PROVIDER CREDENTIALS — Gmail and Microsoft IMAP compatibility
# -----------------------------------------------------------------------------
# Gmail and Microsoft IMAP accounts sign in with OAuth2 instead of an app password.
# Native Microsoft Graph/Exchange support remains future scope under ADR-0040.
# These native client credentials are injected into each platform target's
# Info.plist by the run script (and by `tuist generate` for direct Xcode
# builds), then resolved by
# `OAuthClientConfiguration`. Google uses separate native clients: Desktop for
# macOS and iOS for the iPhone/iPad target. Google's Desktop client requires
# its generated credential during macOS token and refresh exchanges. A native
# binary cannot keep that value confidential, so Brev treats it as a public
# client identifier and relies on PKCE, state, exact loopback redirects, and
# Keychain token storage. iOS does not receive it.
# When unset, the matching "Sign in with Google/Microsoft" button stays hidden
# and accounts fall back to manual IMAP/app-password — so leaving these blank is
# safe. Re-run `tuist generate` after changing them.
#
# Google macOS/Desktop uses the loopback base below. Brev allocates a random
# port and appends /oauth2redirect for each sign-in, then reuses that exact URI
# during token exchange. Google iOS exposes a reversed-client-ID URL scheme;
# keep it exactly equal to the callback scheme.
# Microsoft OAuth registers: brev://oauth
#
# Google: console.cloud.google.com → APIs & Services → Credentials → create one
#   Desktop client and one iOS client, enable the Gmail API, and copy each
#   public client ID. The Gmail IMAP/SMTP grant uses the restricted
#   https://mail.google.com/ scope. For Workspace-only testing, use an Internal
#   consent screen; Testing audience refresh tokens expire after seven days.
# BREV_GOOGLE_OAUTH_MACOS_CLIENT_ID=<desktop-client-id>.apps.googleusercontent.com
# BREV_GOOGLE_OAUTH_CLIENT_SECRET=<desktop-generated-client-credential>
# BREV_GOOGLE_OAUTH_MACOS_REDIRECT_URI=http://127.0.0.1
# BREV_GOOGLE_OAUTH_MACOS_CALLBACK_SCHEME=http
# BREV_GOOGLE_OAUTH_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com
# BREV_GOOGLE_OAUTH_IOS_CALLBACK_SCHEME=com.googleusercontent.apps.<reversed-id>
# BREV_GOOGLE_OAUTH_IOS_REDIRECT_URI=com.googleusercontent.apps.<reversed-id>:/oauth2redirect
# Optional, local-only compatibility (never use for a release build):
# BREV_LOCAL_QA=1
# BREV_GOOGLE_OAUTH_CLIENT_ID=<legacy-client-id>.apps.googleusercontent.com
#
# Microsoft: portal.azure.com → App registrations → register a multi-tenant app,
#   add delegated permissions (IMAP.AccessAsUser.All, SMTP.Send, offline_access),
#   and add brev://oauth as a "Mobile and desktop applications" redirect URI.
# BREV_MICROSOFT_OAUTH_CLIENT_ID=<application-client-id>

# -----------------------------------------------------------------------------
# RELEASE MACHINE ONLY: Developer ID signing and notarization
# (Never set these in CI or shared machines)
# -----------------------------------------------------------------------------

# Developer ID Application certificate name (from Keychain):
# BREV_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)

# Apple Developer team ID (10-char alphanumeric):
# BREV_TEAM_ID=XXXXXXXXXX

# App Store Connect API key for notarization:
# BREV_ASC_KEY_ID=XXXXXXXXXX
# BREV_ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BREV_ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Sparkle 2 EdDSA public key (safe to share; embed in app bundle):
# BREV_SPARKLE_PUBLIC_ED_KEY=<base64-encoded-public-key>

# Positive, monotonically increasing CFBundleVersion chosen for each release:
# BREV_BUILD_NUMBER=<next-monotonic-build-number>

# -----------------------------------------------------------------------------
# OPTIONAL DEVELOPMENT OVERRIDES
# -----------------------------------------------------------------------------

# Override the Sparkle appcast URL for local testing:
# BREV_LOCAL_APPCAST_URL=http://localhost:8000/appcast.xml
