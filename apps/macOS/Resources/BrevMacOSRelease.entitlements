<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Required for "Create Meeting" / "Create Task" from a message (ADR-0007);
	     a sandboxed app needs this before EventKit will grant Calendar/Reminders
	     access. Covers both Calendar and Reminders. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Required before the sandbox can grant the local Contacts access declared
	     in Info.plist for recipient and sender suggestions. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- ADR-0083: the app writes WidgetSnapshot.json here for the
	     widget extension to render. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.eu.brevmail.brev</string>
	</array>
	<!-- Sparkle's installer launcher (SUEnableInstallerLauncherService) talks
	     to the sandboxed app over these mach services; without them every
	     update fails with "An error occurred while running the updater". -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- Opt-in iCloud Key-Value preference sync (ADR-0056). Requires
	     iCloud → Key-value storage on the App ID; unsigned local builds
	     get a store that never leaves the device. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
