    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev creates calendar events only when you choose Create Meeting from a message."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev trenger full kalender­tilgang for å opprette hendelser fra e-post."
          }
        }
