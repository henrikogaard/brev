    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev creates calendar events only when you choose Create Meeting from a message."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev trenger full kalender­tilgang for å opprette hendelser fra e-post."
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev creates calendar events only when you choose Create Meeting from a message."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev bruker kalender­tilgang for å opprette hendelser fra e-post."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev uses the camera only when you choose Take Photo or Scan Documents while writing a message. Pictures and scans stay on your device until you send the message."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev bruker kameraet bare når du velger Ta bilde eller Skann dokumenter mens du skriver en melding. Bilder og skanninger blir værende på enheten din til du sender meldingen."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev reads your contacts only to show matching recipients and sender details in mail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev bruker kontakt­tilgang for å vise avsender­detaljer og autoutfylle mottakere."
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Copyright © 2026 Henrik Øgård. Licensed under MIT."
          }
        }
      }
    },
