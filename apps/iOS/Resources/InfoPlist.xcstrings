      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev creates reminders only when you choose Create Task from a message."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev trenger full påminnelses­tilgang for å opprette oppgaver fra e-post."
          }
        }
      }
    },
