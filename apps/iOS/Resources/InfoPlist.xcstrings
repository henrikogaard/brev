    "NSContactsUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Brev reads your contacts only to show matching recipients and sender details in mail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brev bruker kontakt­tilgang for å vise avsender­detaljer og autoutfylle mottakere."
          }
